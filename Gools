        }

        function updateModalSocialUI(item) {
            const isLiked = likedPosts.includes(item.id);
            const inList = watchlist.includes(item.id);
            const creator = item.creator || 'StreamPlus Creator';
            const isFollowing = followedCreators.includes(creator);

            const followBtn = document.getElementById('modal-follow-btn');
            followBtn.textContent = isFollowing ? '✓ फॉलोइंग (Following)' : '+ फॉलो करें (Follow)';
            followBtn.className = isFollowing
                ? "px-4 py-2 rounded-xl bg-white/15 text-emerald-300 border border-emerald-500/30 text-xs sm:text-sm font-bold transition"
                : "px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs sm:text-sm font-bold transition";
            followBtn.onclick = () => toggleFollow(creator);

            const likeBtn = document.getElementById('modal-like-btn');
            likeBtn.innerHTML = `<i data-lucide="heart" class="w-4 h-4 ${isLiked ? 'fill-rose-500 text-rose-500' : ''}"></i> <span>${formatNumber(item.likes || 0)}</span>`;
            likeBtn.onclick = () => toggleLike(item.id);

            const saveBtn = document.getElementById('modal-watchlist-btn');
            saveBtn.innerHTML = `<i data-lucide="bookmark" class="w-4 h-4 ${inList ? 'fill-amber-400 text-amber-400' : ''}"></i> <span>${inList ? 'सेव है' : 'सेव'}</span>`;
            saveBtn.onclick = () => toggleWatchlist(item.id);

            lucide.createIcons();
        }

        function playEpisode(url, epTitle, activeIdx) {
            videoEl.src = url;
            videoEl.play();
            updatePlayIcons(true);
            showToast(`चल रहा है: ${epTitle}`);
        }

        function closePlayer() {
            videoEl.pause();
            videoEl.src = "";
            document.getElementById('player-modal').classList.add('hidden');
            document.body.style.overflow = '';
            activeModalItem = null;
            refreshCurrentView();
        }

        function togglePlayPause() {
            if (videoEl.paused) {
                videoEl.play();
                updatePlayIcons(true);
            } else {
                videoEl.pause();
                updatePlayIcons(false);
            }
        }

        function updatePlayIcons(isPlaying) {
            const iconName = isPlaying ? 'pause' : 'play';
            document.getElementById('center-play-icon').setAttribute('data-lucide', iconName);
            document.getElementById('ctrl-play-icon').setAttribute('data-lucide', iconName);
            lucide.createIcons();
        }

        function skipTime(seconds) {
            if (!isNaN(videoEl.duration)) {
                videoEl.currentTime = Math.max(0, Math.min(videoEl.duration, videoEl.currentTime + seconds));
            }
        }

        function toggleMute() {
            videoEl.muted = !videoEl.muted;
            document.getElementById('ctrl-mute-icon').setAttribute('data-lucide', videoEl.muted ? 'volume-x' : 'volume-2');
            lucide.createIcons();
        }

        function toggleFullscreen() {
            const container = document.getElementById('video-container');
            if (!document.fullscreenElement && container.requestFullscreen) {
                container.requestFullscreen();
            } else if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }

        function formatTime(sec) {
            if (isNaN(sec)) return "00:00";
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60);
            return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }

        function setupVideoEvents() {
            videoEl.addEventListener('timeupdate', () => {
                if (!isNaN(videoEl.duration) && videoEl.duration > 0) {
                    progressEl.value = (videoEl.currentTime / videoEl.duration) * 100;
                    timeEl.textContent = `${formatTime(videoEl.currentTime)} / ${formatTime(videoEl.duration)}`;
                }
            });

            progressEl.addEventListener('input', () => {
                if (!isNaN(videoEl.duration)) {
                    videoEl.currentTime = (progressEl.value / 100) * videoEl.duration;
                }
            });

            videoEl.addEventListener('ended', () => updatePlayIcons(false));

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (!document.getElementById('player-modal').classList.contains('hidden')) closePlayer();
                    if (!document.getElementById('upload-modal').classList.contains('hidden')) closeUploadModal();
                }
            });
        }

        function toggleProfileModal() {
            document.getElementById('profile-modal').classList.toggle('hidden');
            updateWatchlistBadges();
            updateWalletUI();
        }

        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "toast-enter px-4 py-3 rounded-xl bg-navy-800/95 border border-blue-500/40 text-white text-xs sm:text-sm font-semibold shadow-xl backdrop-blur-md flex items-center gap-2";
            toast.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400"></span><span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
