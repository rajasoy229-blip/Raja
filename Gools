                earningsSection.classList.remove('hidden');
                renderEarningsDashboard();
                return;
            }

            if (currentCategory === 'all' && !searchQuery) {
                heroSection.classList.remove('hidden');
                carouselsContainer.classList.remove('hidden');
                renderHomeFeed();
                return;
            }

            filteredSection.classList.remove('hidden');
            let results = catalog;

            if (searchQuery) {
                results = results.filter(item =>
                    (item.titleHi || '').toLowerCase().includes(searchQuery) ||
                    (item.titleEn || '').toLowerCase().includes(searchQuery) ||
                    (item.creator || '').toLowerCase().includes(searchQuery) ||
                    (item.desc || '').toLowerCase().includes(searchQuery)
                );
                filteredTitle.textContent = `"${searchQuery}" के लिए खोज परिणाम`;
                filteredSubtitle.textContent = `${results.length} परिणाम मिले`;
            } else if (currentCategory === 'shorts') {
                results = results.filter(i => i.type === 'shorts');
                filteredTitle.textContent = "⚡ शॉर्ट वीडियो (Shorts & Reels)";
                filteredSubtitle.textContent = "तेज़ और मनोरंजक शॉर्ट वीडियो";
            } else if (currentCategory === 'long') {
                results = results.filter(i => i.type === 'long');
                filteredTitle.textContent = "🎬 लॉन्ग वीडियो, व्लॉग्स और मूवीज";
                filteredSubtitle.textContent = "फुल-लेंथ वीडियो, वेब सीरीज़ और लाइव स्पोर्ट्स";
            } else if (currentCategory === 'photos') {
                results = results.filter(i => i.type === 'photos');
                filteredTitle.textContent = "🖼️ फोटो और कम्युनिटी पोस्ट";
                filteredSubtitle.textContent = "क्रिएटर्स की लेटेस्ट तस्वीरें और अपडेट्स";
