        function selectUploadType(type) {
            selectedUploadType = type;
            document.querySelectorAll('.upload-type-btn').forEach(btn => {
                if (btn.dataset.type === type) {
                    btn.className = "upload-type-btn active p-3 rounded-xl border border-blue-500 bg-blue-600/20 text-white flex flex-col items-center gap-1 text-xs font-bold transition";
