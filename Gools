        function handleFilePreview(event) {
            const file = event.target.files[0];
            if (!file) return;

            document.getElementById('upload-file-label').textContent = `चुनी गई फ़ाइल: ${file.name}`;
            const previewBox = document.getElementById('upload-preview-box');
            const imgPreview = document.getElementById('upload-img-preview');
            const vidPreview = document.getElementById('upload-vid-preview');

            const objectUrl = URL.createObjectURL(file);
            uploadedDataUrl = objectUrl;
            previewBox.classList.remove('hidden');

            if (file.type.startsWith('image/')) {
                selectUploadType('photos');
                imgPreview.src = objectUrl;
                imgPreview.classList.remove('hidden');
                vidPreview.classList.add('hidden');
            } else {
                if (selectedUploadType === 'photos') selectUploadType('shorts');
                vidPreview.src = objectUrl;
                vidPreview.classList.remove('hidden');
                imgPreview.classList.add('hidden');
            }
        }

        function handlePostSubmit(event) {
            event.preventDefault();

            const title = document.getElementById('upload-title').value.trim();
            const desc = document.getElementById('upload-desc').value.trim() || "StreamPlus पर शेयर की गई नई पोस्ट।";
            const categoryTag = document.getElementById('upload-category-tag').value;
            const customUrl = document.getElementById('upload-media-url').value.trim();

            if (!title) return;

            const isPhoto = selectedUploadType === 'photos';
            const fallbackPoster = isPhoto
                ? "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1000&q=85"
                : "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1000&q=85";

            const finalMediaUrl = uploadedDataUrl || customUrl || (isPhoto ? fallbackPoster : SAMPLE_VIDEOS[0]);
            const finalPoster = isPhoto ? finalMediaUrl : (customUrl && customUrl.match(/\.(jpeg|jpg|png|webp)$/i) ? customUrl : fallbackPoster);

            const newPost = {
                id: "user-post-" + Date.now(),
                type: selectedUploadType,
                titleHi: title,
                titleEn: title,
                creator: "आरव शर्मा (आप)",
                creatorAvatar: "आर",
                followers: "12.4K",
                views: 1,
                likes: 1,
                categoryTag: categoryTag,
                rating: "NEW",
                year: "2026",
                duration: isPhoto ? "फोटो पोस्ट" : (selectedUploadType === 'shorts' ? "0:30" : "05:15"),
                languages: "हिंदी",
                isUserPost: true,
                poster: finalPoster,
                banner: finalPoster,
                videoUrl: isPhoto ? "" : finalMediaUrl,
                desc: desc,
                comments: []
            };

            catalog.unshift(newPost);
            likedPosts.push(newPost.id);

            // Credit Creator Upload Bonus (+₹25)
            walletStats.viewsEarnings += 25.00;
            saveUserPostsAndWallet();

            closeUploadModal();
            updateWalletUI();
            setCategory('all');
            showToast(`बधाई हो! "${title}" पब्लिश हो गया और आपको +₹25.00 बोनस मिला! 🎉`);
        }

        function saveUserPostsAndWallet() {
            try {
                // Save user posts (excluding temporary blob URLs if needed, keep metadata persistent)
                const userPosts = catalog.filter(p => p.isUserPost).map(p => ({
                    ...p,
                    poster: p.poster.startsWith('blob:') ? "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1000&q=85" : p.poster,
                    videoUrl: p.videoUrl && p.videoUrl.startsWith('blob:') ? SAMPLE_VIDEOS[0] : p.videoUrl
                }));
                localStorage.setItem('streamplus_user_posts', JSON.stringify(userPosts));
                localStorage.setItem('streamplus_wallet', JSON.stringify(walletStats));
                localStorage.setItem('streamplus_likes', JSON.stringify(likedPosts));
            } catch (e) {}
        }

        // ==================== SOCIAL ENGAGEMENT: LIKE, COMMENT, FOLLOW, SHARE ====================
        function toggleLike(id) {
            const item = catalog.find(i => i.id === id);
            if (!item) return;

            const idx = likedPosts.indexOf(id);
            if (idx > -1) {
                likedPosts.splice(idx, 1);
                item.likes = Math.max(0, (item.likes || 1) - 1);
            } else {
                likedPosts.push(id);
                item.likes = (item.likes || 0) + 1;
                showToast("आपने पोस्ट को लाइक किया ❤️");
            }

            try {
                localStorage.setItem('streamplus_likes', JSON.stringify(likedPosts));
            } catch (e) {}

            refreshCurrentView();
            if (activeModalItem && activeModalItem.id === id) {
                updateModalSocialUI(item);
            }
        }

