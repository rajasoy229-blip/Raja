<!DOCTYPE html>
<html lang="hi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StreamPlus (स्ट्रीम प्लस) - Watch Movies, Web Series & Live Sports</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans Devanagari for crisp Hindi & English typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans Devanagari"', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            950: '#070b14',
                            900: '#0b1120',
                            800: '#131c31',
                            700: '#1e293b',
                        },
                        brand: {
                            blue: '#1d4ed8',
                            glow: '#3b82f6',
                            gold: '#f59e0b',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom scrollbar hiding for smooth horizontal carousels */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Subtle card hover scale and glow */
        .poster-card {
            transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease;
        }
        @media (hover: hover) {
            .poster-card:hover {
                transform: scale(1.06) translateY(-4px);
                box-shadow: 0 12px 28px -6px rgba(59, 130, 246, 0.35);
                z-index: 20;
            }
        }

        /* Hero vignette gradient */
        .hero-gradient {
            background: linear-gradient(to top, #070b14 8%, rgba(7, 11, 20, 0.65) 45%, rgba(7, 11, 20, 0.2) 100%),
                        linear-gradient(to right, #070b14 15%, rgba(7, 11, 20, 0.5) 55%, transparent 100%);
        }

        /* Toast notification animation */
        @keyframes slideUpFade {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .toast-enter {
            animation: slideUpFade 0.25s ease-out forwards;
        }
    </style>
</head>
<body class="bg-navy-950 text-slate-100 antialiased selection:bg-brand-glow selection:text-white overflow-x-hidden pb-16 md:pb-8">

    <!-- ==================== TOP NAVIGATION BAR ==================== -->
    <header id="navbar" class="fixed top-0 inset-x-0 z-40 transition-colors duration-300 bg-gradient-to-b from-navy-950/95 via-navy-950/80 to-transparent backdrop-blur-md border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
            
            <!-- Brand Logo & Desktop Tabs -->
            <div class="flex items-center gap-6 lg:gap-10">
                <!-- Logo -->
                <button onclick="setCategory('all')" class="flex items-center gap-2.5 group focus:outline-none">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-500 to-amber-400 flex items-center justify-center shadow-lg shadow-blue-500/30 group-hover:scale-105 transition-transform">
                        <i data-lucide="play" class="w-5 h-5 text-white fill-white ml-0.5"></i>
                    </div>
                    <div class="text-left leading-tight">
                        <span class="block text-lg sm:text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-blue-100 to-amber-300 bg-clip-text text-transparent">
                            StreamPlus
                        </span>
                        <span class="block text-[11px] font-semibold text-amber-400 tracking-wider">स्ट्रीम प्लस</span>
                    </div>
                </button>

                <!-- Desktop Navigation Tabs -->
                <nav class="hidden md:flex items-center gap-1 lg:gap-2" id="desktop-nav">
                    <button data-cat="all" onclick="setCategory('all')" class="nav-tab active px-3.5 py-2 rounded-xl text-sm font-semibold transition-all bg-blue-600/20 text-blue-400 border border-blue-500/30">
                        होम <span class="text-xs opacity-75 font-normal">Home</span>
                    </button>
                    <button data-cat="shorts" onclick="setCategory('shorts')" class="nav-tab px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all flex items-center gap-1">
                        <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i> शॉर्ट्स <span class="text-xs opacity-60">Shorts</span>
                    </button>
                    <button data-cat="long" onclick="setCategory('long')" class="nav-tab px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all">
                        लॉन्ग वीडियो <span class="text-xs opacity-60">Videos</span>
                    </button>
                    <button data-cat="photos" onclick="setCategory('photos')" class="nav-tab px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all">
                        फोटो <span class="text-xs opacity-60">Photos</span>
                    </button>
                    <button data-cat="earnings" onclick="setCategory('earnings')" class="nav-tab px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all flex items-center gap-1.5">
                        <i data-lucide="indian-rupee" class="w-3.5 h-3.5 text-emerald-400"></i> कमाई <span class="text-xs opacity-60">Earnings</span>
                    </button>
                    <button data-cat="mylist" onclick="setCategory('mylist')" class="nav-tab px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 transition-all flex items-center gap-1.5">
                        मेरी लिस्ट <span class="text-xs opacity-60">Saved</span>
                        <span id="nav-watchlist-count" class="hidden px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-amber-500 text-navy-950">0</span>
                    </button>
                </nav>
            </div>

            <!-- Right Actions: Live Search, Upload & Profile -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Live Search Input -->
                <div class="relative flex items-center">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 pointer-events-none"></i>
                    <input 
                        type="text" 
                        id="search-input"
                        placeholder="खोजें (वीडियो, फोटो, क्रिएटर...)" 
                        class="w-32 sm:w-48 lg:w-56 pl-9 pr-7 py-2 rounded-xl bg-navy-800/90 border border-white/10 text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                    >
                    <button id="clear-search" onclick="clearSearch()" class="hidden absolute right-2 text-slate-400 hover:text-white">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <!-- Prominent Upload / Create Post Button -->
                <button onclick="openUploadModal()" class="px-3 sm:px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-500 hover:from-blue-500 hover:to-indigo-500 text-white text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-lg shadow-blue-600/30 transition active:scale-95 shrink-0">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span>पोस्ट करें <span class="hidden lg:inline font-normal opacity-90">/ Upload</span></span>
                </button>

                <!-- Wallet Balance Pill (Desktop) -->
                <button onclick="setCategory('earnings')" class="hidden xl:flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold hover:bg-emerald-500/25 transition" title="कमाई डैशबोर्ड खोलें">
                    <i data-lucide="wallet" class="w-3.5 h-3.5 text-emerald-400"></i>
                    <span id="header-wallet-bal">₹1,245.50</span>
                </button>

                <!-- User Profile Button -->
                <button onclick="toggleProfileModal()" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-navy-800 border border-white/15 flex items-center justify-center hover:border-blue-400 transition overflow-hidden shrink-0" title="प्रोफ़ाइल (Profile)">
                    <div class="w-full h-full bg-gradient-to-br from-blue-600 to-indigo-800 flex items-center justify-center text-sm font-bold text-white">
                        आर
                    </div>
                </button>
            </div>
        </div>

        <!-- Mobile Horizontal Category Pill Strip -->
        <div class="md:hidden flex items-center gap-2 px-4 py-2 overflow-x-auto no-scrollbar border-t border-white/5 bg-navy-950/90">
            <button data-cat="all" onclick="setCategory('all')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-600 text-white">
                सब कुछ (Home)
            </button>
            <button data-cat="shorts" onclick="setCategory('shorts')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-navy-800 text-slate-300 border border-white/5">
                ⚡ शॉर्ट्स (Shorts)
            </button>
            <button data-cat="long" onclick="setCategory('long')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-navy-800 text-slate-300 border border-white/5">
                🎬 लॉन्ग वीडियो (Videos)
            </button>
            <button data-cat="photos" onclick="setCategory('photos')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-navy-800 text-slate-300 border border-white/5">
                🖼️ फोटो (Photos)
            </button>
            <button data-cat="earnings" onclick="setCategory('earnings')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-navy-800 text-emerald-300 border border-emerald-500/20">
                ₹ कमाई (Earnings)
            </button>
            <button data-cat="mylist" onclick="setCategory('mylist')" class="mobile-tab shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-navy-800 text-slate-300 border border-white/5">
                मेरी लिस्ट (Saved)
            </button>
        </div>
    </header>

    <!-- ==================== MOBILE BOTTOM NAVIGATION BAR ==================== -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-navy-950/95 backdrop-blur-lg border-t border-white/10 px-2 py-1.5 flex items-center justify-around">
        <button onclick="setCategory('all')" class="flex flex-col items-center gap-0.5 text-[10px] font-semibold text-blue-400">
            <i data-lucide="home" class="w-5 h-5"></i>
            <span>होम</span>
        </button>
        <button onclick="setCategory('shorts')" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-slate-300 hover:text-white">
            <i data-lucide="zap" class="w-5 h-5 text-amber-400"></i>
            <span>शॉर्ट्स</span>
        </button>
        <button onclick="openUploadModal()" class="flex flex-col items-center justify-center -mt-5 w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-amber-400 text-white shadow-lg shadow-blue-600/40 border-2 border-navy-950">
            <i data-lucide="plus" class="w-6 h-6"></i>
        </button>
        <button onclick="setCategory('photos')" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-slate-300 hover:text-white">
            <i data-lucide="image" class="w-5 h-5"></i>
            <span>फोटो</span>
        </button>
        <button onclick="setCategory('earnings')" class="flex flex-col items-center gap-0.5 text-[10px] font-medium text-emerald-400">
            <i data-lucide="indian-rupee" class="w-5 h-5"></i>
            <span>कमाई</span>
        </button>
    </nav>

    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <main id="main-content" class="pt-24 md:pt-0 pb-10">
        
        <!-- HERO SPOTLIGHT BANNER -->
        <section id="hero-section" class="relative w-full min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] flex items-end pb-10 sm:pb-12 pt-20 overflow-hidden">
            <img id="hero-bg" src="" alt="Featured Spotlight" class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-700 scale-105">
            <div class="absolute inset-0 hero-gradient"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                <div class="max-w-2xl space-y-3.5">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="px-2.5 py-1 rounded-lg bg-amber-500 text-navy-950 text-xs font-extrabold uppercase tracking-wider flex items-center gap-1 shadow-md">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> ट्रेंडिंग क्रिएटर & OTT
                        </span>
                        <span id="hero-lang" class="px-2.5 py-1 rounded-lg bg-white/10 backdrop-blur-md text-xs font-medium text-blue-200 border border-white/10">
                            हिंदी • English
                        </span>
                        <span id="hero-rating" class="px-2 py-1 rounded-lg bg-navy-900/80 text-amber-400 text-xs font-bold flex items-center gap-1 border border-amber-500/20">
                            ★ 9.2
                        </span>
                    </div>

                    <div>
                        <h1 id="hero-title-hi" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight drop-shadow-lg">
                            ब्रह्मांड: एक नई शुरुआत
                        </h1>
                        <p id="hero-title-en" class="text-xs sm:text-base font-semibold text-blue-300 mt-1 tracking-wide">
                            BRAHMAAND: A NEW DAWN (2026)
                        </p>
                    </div>

                    <p id="hero-desc" class="text-xs sm:text-sm text-slate-300 line-clamp-2 leading-relaxed max-w-xl">
                        साल 2099 में जब पृथ्वी की ऊर्जा समाप्त होने लगती है, तब भारतीय अंतरिक्ष वैज्ञानिकों की एक टीम ब्रह्मांड के सबसे रहस्यमयी ग्रह की ओर एक असंभव मिशन पर निकलती है।
                    </p>

                    <div class="pt-1 flex flex-wrap items-center gap-3">
                        <button id="hero-watch-btn" onclick="openMediaModal(featuredItem.id)" class="px-6 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-blue-600/40 transition active:scale-95">
                            <i data-lucide="play" class="w-4 h-4 fill-white"></i>
                            <span>अभी देखें (Watch)</span>
                        </button>

                        <button onclick="openUploadModal()" class="px-5 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 backdrop-blur-md border border-amber-400/40 text-amber-300 font-bold text-sm flex items-center justify-center gap-2 transition active:scale-95">
                            <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                            <span>अपना वीडियो/फोटो डालें</span>
                        </button>

                        <button id="hero-list-btn" onclick="toggleWatchlist(featuredItem.id)" class="px-4 py-3 rounded-xl bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/15 text-white font-semibold text-sm flex items-center justify-center gap-2 transition">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>मेरी लिस्ट</span>
                        </button>
                    </div>
                </div>
                <div id="hero-dots" class="flex items-center gap-2 mt-5"></div>
            </div>
        </section>

        <!-- CREATOR & VIEWER EARNINGS DASHBOARD (कमाई डैशबोर्ड) -->
        <section id="earnings-section" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 md:pt-24 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5">
                <div>
                    <span class="px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-bold border border-emerald-500/30">
                        StreamPlus Monetization • लाइव कमाई
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-2">कमाई और वॉलेट डैशबोर्ड (Creator & Viewer Earnings)</h2>
                    <p class="text-xs sm:text-sm text-slate-400 mt-1">वीडियो/फोटो पोस्ट करने, व्यूज, लाइक्स और वीडियो देखने पर सीधा रिवॉर्ड कमाएं।</p>
                </div>
                <button onclick="openUploadModal()" class="px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i> नया कंटेंट पोस्ट करें (+₹25 बोनस)
                </button>
            </div>

            <!-- Earnings Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-950/80 to-navy-900 border border-emerald-500/30 space-y-2">
                    <div class="flex items-center justify-between text-emerald-400">
                        <span class="text-xs font-semibold">कुल वॉलेट बैलेंस (Wallet Balance)</span>
                        <i data-lucide="wallet" class="w-5 h-5"></i>
                    </div>
                    <p id="dash-wallet-balance" class="text-3xl font-extrabold text-white">₹1,245.50</p>
                    <p class="text-xs text-emerald-300">+₹142.00 आज की कमाई</p>
                </div>

                <div class="p-5 rounded-2xl bg-navy-900 border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-blue-400">
                        <span class="text-xs font-semibold">क्रिएटर व्यूज कमाई (Creator Views)</span>
                        <i data-lucide="eye" class="w-5 h-5"></i>
                    </div>
                    <p id="dash-views-earnings" class="text-3xl font-extrabold text-white">₹890.00</p>
                    <p id="dash-total-views" class="text-xs text-slate-400">कुल व्यूज: 44,500</p>
                </div>

                <div class="p-5 rounded-2xl bg-navy-900 border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-amber-400">
                        <span class="text-xs font-semibold">वॉच एंड अर्न रिवॉर्ड (Watch Rewards)</span>
                        <i data-lucide="gift" class="w-5 h-5"></i>
                    </div>
                    <p id="dash-watch-earnings" class="text-3xl font-extrabold text-white">₹355.50</p>
                    <p class="text-xs text-slate-400">हर वीडियो देखने पर +₹2.50 रिवॉर्ड</p>
                </div>

                <div class="p-5 rounded-2xl bg-navy-900 border border-white/10 space-y-2 flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold text-purple-400">बैंक / UPI निकासी (Instant Payout)</span>
                        <p class="text-sm font-bold text-white mt-1">न्यूनतम निकासी: ₹500</p>
                    </div>
                    <button onclick="withdrawEarnings()" class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition">
                        UPI में पैसे निकालें (Withdraw)
                    </button>
                </div>
            </div>

            <!-- Your Uploaded Posts Performance Table -->
            <div class="bg-navy-900/90 border border-white/10 rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                        <i data-lucide="bar-chart-3" class="w-5 h-5 text-amber-400"></i>
                        आपकी पोस्ट्स और कमाई का विवरण (Your Posts & Revenue)
                    </h3>
                    <span id="user-posts-count-badge" class="px-3 py-1 rounded-full bg-blue-600/20 text-blue-300 text-xs font-bold">0 पोस्ट</span>
                </div>
                <div id="earnings-posts-list" class="divide-y divide-white/10">
                    <!-- Injected via JS -->
                </div>
            </div>
        </section>

        <!-- SEARCH / FILTERED GRID VIEW -->
        <section id="filtered-section" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 md:pt-24 space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
                <div>
                    <h2 id="filtered-title" class="text-xl sm:text-2xl font-bold text-white">खोज के परिणाम</h2>
                    <p id="filtered-subtitle" class="text-xs sm:text-sm text-slate-400 mt-0.5">आपके लिए चुने गए शीर्षक</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="openUploadModal()" class="px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
                        <i data-lucide="plus" class="w-4 h-4"></i> पोस्ट डालें
                    </button>
                    <button onclick="setCategory('all')" class="px-3.5 py-2 rounded-xl bg-navy-800 hover:bg-navy-700 text-xs sm:text-sm font-medium text-slate-300 flex items-center gap-1.5 border border-white/10">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i> होम
                    </button>
                </div>
            </div>

            <div id="filtered-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"></div>

            <div id="empty-state" class="hidden py-16 text-center space-y-3 bg-navy-900/50 rounded-2xl border border-white/5">
                <div class="w-14 h-14 rounded-2xl bg-navy-800 mx-auto flex items-center justify-center text-slate-400">
                    <i data-lucide="film" class="w-7 h-7"></i>
