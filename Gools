                results = results.filter(i => watchlist.includes(i.id));
                filteredTitle.textContent = "🔖 मेरी सेव की गई लिस्ट (Saved)";
                filteredSubtitle.textContent = "आपके पसंदीदा वीडियो और पोस्ट";
            }

            if (results.length === 0) {
                filteredGrid.innerHTML = '';
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                filteredGrid.innerHTML = results.map(item => createSocialCardHTML(item)).join('');
            }
            lucide.createIcons();
        }

